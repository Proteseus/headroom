[Unit]
Description=Headroom local quota host
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/headroom/host
ExecStart=/usr/bin/python3 %h/.local/share/headroom/host/headroom_server.py --port 8737
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
