# secrets — Wi-Fi creds live here, never commit
firmware/src/config.h

# platformio build output
firmware/.pio/

# python
__pycache__/
*.pyc
.pytest_cache/
.venv-shots/

# macOS / Xcode. project.yml is the source of truth: XcodeGen writes the
# .xcodeproj on every build, so tracking it only produces UUID churn.
macos/Headroom.xcodeproj/
macos/.build/
macos/.build-ios/
macos/.build-ios-shots/
macos/.build-release/
macos/host/
dist/
*.xcuserstate
xcuserdata/

# Per-machine agent settings (permission allowlists, not project config).
.claude/settings.local.json

# OS junk
.DS_Store
**/.DS_Store

# Per-machine firmware build counter (see firmware/version.py).
firmware/.build_number
firmware/.flashed_build
