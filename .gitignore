# secrets — Wi-Fi creds live here, never commit
firmware/src/config.h

# platformio build output
firmware/.pio/

# python
__pycache__/
*.pyc
.pytest_cache/
.venv-shots/

# macOS / Xcode. project.yml is the source of truth: XcodeGen writes the
# .xcodeproj on every build, so tracking it only produces UUID churn.
macos/Headroom.xcodeproj/
# Every derivedDataPath this repo uses, and the next one someone invents.
macos/.build*/
macos/build/
macos/host/
dist/
*.xcuserstate
xcuserdata/

# Per-machine agent settings (permission allowlists, not project config).
.claude/settings.local.json

# OS junk
.DS_Store
**/.DS_Store

# Per-machine firmware build counter (see firmware/version.py).
firmware/.build_number
firmware/.flashed_build

# Signing material. Certificates and App Store Connect keys live in the
# keychain and in GitHub secrets, never here — this is a backstop for the
# working copy someone exports to their Desktop mid-release.
*.p12
*.p8
*.mobileprovision
